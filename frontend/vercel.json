{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/mandi-api/(.*)",
      "destination": "https://vegetablemarketprice.com/$1"
    },
    {
      "source": "/fruits-api/(.*)",
      "destination": "https://vegetablemarketprice.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
